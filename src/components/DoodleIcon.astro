---
interface Props { name: 'tree' | 'note' | 'now' | 'tool' | 'github' | 'spark' | 'folder' | 'snapshot' | 'arrow'; size?: number; }
const { name, size = 42 } = Astro.props;
---
<svg class={`doodle-icon icon-${name}`} width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'tree' && <><path d="M24 8v9m0 0-11 8m11-8 11 8M13 25v8m22-8v8M13 33l-5 7m5-7 5 7m17-7-5 7m5-7 5 7"/><circle cx="24" cy="7" r="3.2"/><circle cx="13" cy="25" r="3"/><circle cx="35" cy="25" r="3"/><path d="M5 41h6m4 0h6m4 0h6m4 0h6"/></>}
  {name === 'note' && <><path d="m10 7 26-1 3 33-27 2L10 7Z"/><path d="m16 15 15-1m-14 7 16-1m-15 7 11-1m-10 7 14-1"/><path class="accent-stroke" d="m7 12-2 25"/></>}
  {name === 'now' && <><circle cx="24" cy="24" r="16"/><path d="M24 14v11l8 5"/><path class="accent-stroke" d="m9 7 4 3m26-3-4 3"/></>}
  {name === 'tool' && <><path d="m13 9 22 1 3 28-24 2-3-28 2-3Z"/><path d="M17 9V5h14v4m-13 9h12m-12 7h8"/><path class="accent-stroke" d="m8 34 4 8"/></>}
  {name === 'github' && <><path d="M15 36c-4-2-6-5-6-11 0-8 6-14 15-14s15 6 15 14c0 6-2 9-6 11"/><path d="M18 35v-6c0-3 2-5 6-5s6 2 6 5v6m-12-2c-3 1-5 0-7-2m19 2c3 1 5 0 7-2M18 35v6m12-6v6"/><path d="M16 15c1-3 4-4 8-4s7 1 8 4"/></>}
  {name === 'spark' && <><path d="m24 5 2.5 13L38 24l-11.5 3L24 40l-3-13-11-3 11-6 3-13Z"/><path class="accent-stroke" d="m37 7 1 5 5 1-5 1-1 5-1-5-5-1 5-1 1-5Z"/></>}
  {name === 'folder' && <><path d="m6 14 14-1 4 5 18-1-2 23-32 1-2-27Z"/><path d="m7 20 32-1"/><path class="accent-stroke" d="m13 27 14-1m-13 7 10-1"/></>}
  {name === 'snapshot' && <><path d="m9 12 29-2 2 28-29 2-2-28Z"/><path d="m15 18 16-1m-15 7 18-1"/><path class="accent-stroke" d="m5 17 2 25 28-2"/></>}
  {name === 'arrow' && <><path d="M8 25c12-1 21-4 30-11m-9-1 10-1-1 10"/><path class="accent-stroke" d="M11 32c7 0 13-1 18-3"/></>}
</svg>
