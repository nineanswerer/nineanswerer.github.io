---
import { site } from '../config';
---
<footer class="site-footer editorial-footer">
  <div class="shell footer-main">
    <div class="footer-note">
      <span class="index-label">KEEP EXPLORING</span>
      <p>想法，还在继续<span>↗</span></p>
      <a href={site.github} target="_blank" rel="noreferrer" class="footer-github">在 GitHub 找到我 ↗</a>
    </div>
    <nav class="footer-links" aria-label="页脚导航">
      <a href={site.github} target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
      <a href="/rss.xml">RSS <span>↗</span></a>
      <a href={site.repository} target="_blank" rel="noreferrer">网站源码 <span>↗</span></a>
      <a href="/about/">关于这个网站 <span>→</span></a>
      <a href="/admin/">内容后台 <span>→</span></a>
    </nav>
  </div>
  <div class="shell footer-wordmark" aria-hidden="true">NINEANSWERER<span>©</span></div>
  <div class="shell footer-base">
    <span>© {new Date().getFullYear()} 九术 / NineAnswerer</span>
    <span>持续制作，持续记录。</span>
  </div>
</footer>
