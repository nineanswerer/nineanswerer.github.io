---
import { navigation } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href) || (href === '/writing/' && path.startsWith('/notes/'));
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="九术的工作台，返回首页">
      <span class="brand-mark" aria-hidden="true">九<span></span></span>
      <span class="brand-type"><strong>九术的工作台</strong><small>NINE'S WORKSHOP</small></span>
    </a>
    <nav class="main-nav desktop-nav" aria-label="主导航">
      {navigation.map((item) => <a href={item.href} class:list={[{ active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="search-link" href="/search/" aria-label="搜索项目和文章">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><span>搜索</span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色主题" title="切换深浅色主题">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"/></svg>
      </button>
      <details class="mobile-nav">
        <summary aria-label="展开导航"><span></span><span></span></summary>
        <nav aria-label="移动端导航">{navigation.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}<span>↗</span></a>)}</nav>
      </details>
    </div>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* The visual toggle still works without storage. */ }
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#191a18' : '#f5f0e6');
    });
  });
</script>
