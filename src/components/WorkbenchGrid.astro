---
import type { FeedItem } from '../content';
import { site } from '../config';
import DoodleIcon from './DoodleIcon.astro';
import MiniDirectoryTree from './MiniDirectoryTree.astro';

interface Props { latestPost: FeedItem; latestNote: FeedItem; }
const { latestPost, latestNote } = Astro.props;
---
<div class="workbench-grid" aria-label="九术的九宫格工作台">
  <div class="workbench-cell tree-cell"><MiniDirectoryTree /></div>
  <a class="workbench-cell writing-cell" href={latestPost.url}>
    <span class="cell-label">02 / 最新长文 <DoodleIcon name="note" size={23} /></span>
    <strong>{latestPost.title}</strong>
    <span class="cell-foot">翻开读一读 <span>↗</span></span>
  </a>
  <a class="workbench-cell now-cell" href="/now/">
    <span class="cell-label">03 / 现在便签 <DoodleIcon name="now" size={26} /></span>
    <strong>最近在做<br />哪些事？</strong>
    <span class="pencil-note">只记真实进展。</span>
    <span class="cell-foot">查看现在 <span>→</span></span>
  </a>
  <a class="workbench-cell minecraft-cell" href="/projects/mc-translate-skill/">
    <span class="cell-label">04 / Minecraft 工具 <DoodleIcon name="tool" size={25} /></span>
    <strong>让本地化<br />可以接着做。</strong>
    <span class="cell-foot">mc-Translate-skill <span>↗</span></span>
  </a>
  <div class="workbench-cell seal-cell" role="img" aria-label="九术的工作台印章">
    <span class="big-seal">九</span>
    <span>想法 → 作品</span>
  </div>
  <a class="workbench-cell note-cell" href={latestNote.url}>
    <span class="cell-label">06 / 最近碎片 <DoodleIcon name="spark" size={23} /></span>
    <strong>{latestNote.title}</strong>
    <span class="cell-foot">一张小纸条 <span>↗</span></span>
  </a>
  <a class="workbench-cell github-cell" href={site.github} target="_blank" rel="noreferrer">
    <span class="cell-label">07 / 代码仓库 <DoodleIcon name="github" size={29} /></span>
    <strong>@nineanswerer</strong>
    <span class="cell-foot">在 GitHub 上继续 <span>↗</span></span>
  </a>
  <a class="workbench-cell experiment-cell" href="/writing/hugo-to-astro-casebook/">
    <span class="cell-label">08 / 界面小实验 <DoodleIcon name="snapshot" size={24} /></span>
    <strong>方格纸、墨色<br />与深色主题。</strong>
    <span class="cell-foot">这次怎么改 <span>→</span></span>
  </a>
  <div class="workbench-cell blank-cell" aria-hidden="true">
    <span class="paper-tape"></span>
    <svg viewBox="0 0 120 75"><path d="M12 58c24-37 39 14 65-25m-8-3 10-2-1 11"/><path d="M18 66c21-4 38-5 61-4"/></svg>
    <span>留一点空白。</span>
  </div>
</div>
