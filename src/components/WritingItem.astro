---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';
interface Props { post: CollectionEntry<'writing'>; showTags?: boolean; compact?: boolean; }
const { post, showTags = true, compact = false } = Astro.props;
---
<article class:list={['writing-item', { compact }]}>
  <a href={`/writing/${post.id}/`}>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <div>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      {showTags && !compact && <ul class="inline-tags" aria-label="文章标签">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </div>
    <span class="writing-arrow" aria-hidden="true">↗</span>
  </a>
</article>
