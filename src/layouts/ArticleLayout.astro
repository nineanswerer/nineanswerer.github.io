---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils';

interface Heading { depth: number; slug: string; text: string; }
interface RelatedProject { id: string; data: { title: string; tagline: string; }; }
interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  headings?: Heading[];
  eyebrow?: string;
  kind?: '长文' | '碎片';
  relatedProject?: RelatedProject;
}
const { title, description, date, updated, tags = [], headings = [], eyebrow = '写作缘由 / 实践记录', kind = '长文', relatedProject } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={title} description={description}>
  <div class:list={['shell', 'article-shell', { 'note-reading': kind === '碎片' }]}>
    <header class="article-header">
      <a class="back-link" href="/writing/">← 返回博客</a>
      <span class="eyebrow">{kind} / {eyebrow}</span>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="article-byline">
        <span>九术 / NineAnswerer</span>
        <time datetime={date.toISOString()}>写于 {formatDate(date)}</time>
        {updated && <span>修订于 {formatDate(updated)}</span>}
        {tags.map((tag) => <span class="article-tag">{tag}</span>)}
      </div>
    </header>
    <div class:list={['article-grid', { 'no-toc': toc.length === 0 }]}>
      {toc.length > 0 && (
        <aside class="toc" aria-label="文章目录">
          <span class="eyebrow">这页写了什么</span>
          <nav>{toc.map((heading) => <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
        </aside>
      )}
      <div>
        <article class="prose"><slot /></article>
        {relatedProject && <aside class="article-related" aria-label="关联项目">
          <span class="eyebrow">这篇记录来自</span>
          <h2>{relatedProject.data.title}</h2>
          <p>{relatedProject.data.tagline}</p>
          <a class="text-link" href={`/projects/${relatedProject.id}/`}>查看项目职责、验证与不足 →</a>
        </aside>}
        <p class="article-revision">这份记录描述写作时的实现与验证范围，实质修订后会更新日期。</p>
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.className = 'copy-code';
    button.type = 'button';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制代码');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
        button.textContent = '已复制';
        setTimeout(() => { button.textContent = '复制'; }, 1600);
      } catch {
        button.textContent = '复制失败';
      }
    });
    pre.appendChild(button);
  });
</script>
