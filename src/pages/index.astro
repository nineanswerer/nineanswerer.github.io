---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeedItems, getPublishedProjects } from '../content';
import { selectHomeProjects } from '../home-model';
import FeaturedProject from '../components/home/FeaturedProject.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import '../styles/home.css';
import { formatDate } from '../utils';
import KineticSculpture from '../components/KineticSculpture.astro';

const [projects, homeEntry] = await Promise.all([getPublishedProjects(), getEntry('home', 'index')]);
if (!homeEntry) throw new Error('缺少首页配置：src/content/home/index.json');
const home = homeEntry.data;
const { featured, projects: selected, total } = selectHomeProjects(projects, home.projectsLimit);
const feed = await getFeedItems();
const posts = feed.filter((item) => item.type === '长文');
const notes = feed.filter((item) => item.type === '碎片');
const leadPost = posts[0];
---
<BaseLayout bodyClass="experimental-page">
  <div class="editorial-home">
    <section class="manifesto" aria-labelledby="home-title">
      <div class="manifesto-top"><span class="index-label">NINEANSWERER / A WORKSHOP IN MOTION</span><span class="index-label"><span class="live-mark" aria-hidden="true"></span>个人项目 · 生成式视觉 · 持续探索</span></div>
      <div class="manifesto-grid">
        <div class="manifesto-copy">
          <span class="hero-edition">{home.edition}</span>
          <h1 id="home-title"><span>{home.heading[0]}<span class="hero-comma">，</span></span><span class="title-accent">{home.heading[1]}<span class="title-period">。</span></span></h1>
          <div class="manifesto-intro"><span class="intro-arrow" aria-hidden="true">↳</span><p>{home.intro}</p></div>
        </div>
        <KineticSculpture enabled={home.visual.enabled} autoplay={home.visual.autoplay} />
      </div>
      <div class="manifesto-bottom">
        <a class="hero-project-link" href="#selected-work"><span>探索作品</span><span class="round-action" aria-hidden="true">↓</span></a>
        <p class="hero-status"><span class="status-dot" aria-hidden="true"></span>{home.status} <a href="/now/">最近在做什么 ↗</a></p>
        <span class="index-label scroll-note">SCROLL TO EXPLORE</span>
      </div>
    </section>

    <div class="kinetic-band" aria-hidden="true" data-kinetic-band><div class="kinetic-band-track"><span>CURIOSITY</span><i>↗</i><span class="band-outline">CODE</span><i>×</i><span>CRAFT</span><i>↗</i><span class="band-outline">CURIOSITY</span><i>×</i><span>CODE</span></div></div>

    <section class="selected-work making-section" id="selected-work" aria-labelledby="work-title">
      <div class="editorial-section-head"><div><span class="index-label">01 / SELECTED WORK</span><h2 id="work-title">从问题出发<span class="accent-dot">.</span></h2></div><span class="section-side-note">{total} 个项目，持续生长。<br />每件作品，都有来处。</span></div>
      {featured && <FeaturedProject project={featured} />}
      {selected.length > 0 && <div class="project-pair">{selected.map((project, index) => <ProjectCard project={project} index={index} />)}</div>}
      {!featured && <p class="content-empty">作品正在整理。新的实践会在这里留下记录。</p>}
      <div class="work-index-link"><span class="index-label">所有项目均保留职责与贡献说明</span><a class="editorial-link" href="/projects/">打开完整项目架 ↗</a></div>
    </section>

    <section class="journal-section" id="journal" aria-labelledby="journal-title">
      <div class="editorial-section-head"><div><span class="index-label">02 / FIELD NOTES</span><h2 id="journal-title">做过，也写下来<span class="accent-dot">.</span></h2></div><a class="editorial-link" href="/writing/">全部写作 ↗</a></div>
      {leadPost && <div class="journal-grid">
        <article class="journal-feature" data-reveal><a href={leadPost.url}>
          <div class="journal-feature-top"><span class="index-label">{leadPost.updated && leadPost.updated > leadPost.date ? '最近修订' : '最新发布'} / 长文</span><time datetime={(leadPost.updated ?? leadPost.date).toISOString()}>{formatDate(leadPost.updated ?? leadPost.date)}</time></div>
          <h3>{leadPost.title}</h3><p>{leadPost.description}</p><span class="journal-read">读这篇记录 <span aria-hidden="true">↗</span></span>
        </a></article>
        <div class="journal-list">{posts.slice(1,4).map((post,index) => <article class="journal-entry" data-reveal><a href={post.url}><span class="journal-entry-meta"><span>ESSAY / {String(index+2).padStart(2,'0')}</span><time datetime={(post.updated ?? post.date).toISOString()}>{formatDate(post.updated ?? post.date)}</time></span><h3>{post.title}</h3><span class="journal-entry-arrow" aria-hidden="true">↗</span></a></article>)}</div>
      </div>
      }
      {notes.length > 0 && <div class="margin-notes"><div class="margin-notes-label"><span class="index-label">MARGIN NOTES</span><span>一些小发现。</span></div>{notes.slice(0,2).map(note => <a href={note.url}><span>随手记 / 碎片</span><h3>{note.title}</h3><span aria-hidden="true">↗</span></a>)}</div>}
      {!leadPost && notes.length === 0 && <p class="content-empty">记录正在整理，先去看看作品。</p>}
    </section>

    <section class="about-statement" aria-labelledby="about-statement-title">
      <span class="index-label">03 / THE PERSON BEHIND</span><div class="about-statement-grid" data-reveal><h2 id="about-statement-title">{home.about.heading[0]}<br />{home.about.heading[1]}</h2><div><p>{home.about.text}</p><p class="about-collaboration">{home.about.collaboration}</p><a class="editorial-link" href="/about/">多了解一点九术 ↗</a></div></div>
    </section>
  </div>
</BaseLayout>
<script>
  import { mountHomeMotion } from '../scripts/home-motion';
  const root = document.querySelector<HTMLElement>('.editorial-home');
  if (root) {
    const dispose = mountHomeMotion(root);
    document.addEventListener('astro:before-swap', dispose, { once: true });
  }
</script>
