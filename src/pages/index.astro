---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingItem from '../components/WritingItem.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((project) => project.data.featured) ?? projects[0];
const otherProjects = projects.filter((project) => project.id !== featured.id);
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  <div class="shell">
    <section class="home-hero">
      <div class="hero-copy">
        <span class="eyebrow">NINEANSWERER / ENGINEERING CASEBOOK</span>
        <h1>把复杂系统，<br />做成<em>可读的结构。</em></h1>
        <p class="hero-intro">我是九术，一名持续把想法做成可用工具的开发者。这里不堆技术名词，只记录真实项目里的问题、取舍、验证与尚未解决的边界。</p>
        <div class="button-row">
          <a class="button" href={`/projects/${featured.id}/`}>阅读代表案例 <span>↗</span></a>
          <a class="button secondary" href="/projects/">查看全部项目</a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="档案说明">
        <div class="hero-note">
          <span class="note-no">01 — 定位</span>
          <span class="eyebrow">BUILD · TEST · EXPLAIN</span>
          <p>从桌面应用到自动化工作流，<br />从实现细节到公开复盘。</p>
        </div>
        <div class="hero-index" aria-hidden="true"><span>问题</span><span>方案</span><span>证据</span></div>
      </aside>
    </section>

    <section class="section-block" aria-labelledby="featured-title">
      <div class="section-heading-inline">
        <div><span class="eyebrow">FEATURED CASE / 代表案例</span><h2 id="featured-title">从真实问题开始</h2></div>
        <a class="text-link" href={featured.data.repo} target="_blank" rel="noreferrer">源代码 ↗</a>
      </div>
      <article class="feature-case">
        <div class="feature-case-copy">
          <div class="case-kicker"><span>DESKTOP APPLICATION</span><span>{featured.data.status}</span></div>
          <h3>{featured.data.title}</h3>
          <p class="case-tagline">{featured.data.tagline}</p>
          <p class="case-description">{featured.data.description}</p>
          <div class="case-metrics">
            {featured.data.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
          </div>
          <a class="text-link" href={`/projects/${featured.id}/`}>查看完整案例 <span>→</span></a>
        </div>
        <a class="feature-case-visual" href={`/projects/${featured.id}/`} aria-label="查看 StorageScope 的 3D 目录树案例">
          <img src="/images/storagescope-tree.webp" alt="StorageScope 中以层级连线展示目录关系的三维视图" width="1384" height="841" loading="eager" />
          <div class="visual-caption"><span>3D DIRECTORY TREE</span><span>实际应用视图 / 已隐去本机路径</span></div>
        </a>
      </article>
    </section>

    <section class="section-block" aria-labelledby="more-projects">
      <div class="section-heading">
        <span class="eyebrow">SELECTED WORK / 项目档案</span>
        <div><h2 id="more-projects">代码之外，保留决策过程。</h2><p>每个案例都说明做了什么、为什么这样做，以及目前能验证到哪里。</p></div>
      </div>
      <div class="project-list">{otherProjects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      <div style="margin-top: 32px"><a class="text-link" href="/projects/">浏览项目索引 <span>→</span></a></div>
    </section>

    <section class="section-block" aria-labelledby="latest-writing">
      <div class="section-heading-inline">
        <div><span class="eyebrow">FIELD NOTES / 实践笔记</span><h2 id="latest-writing">把踩过的坑，写成可复用的经验。</h2></div>
        <a class="text-link" href="/writing/">全部文章 →</a>
      </div>
      <div class="writing-list">{posts.map((post) => <WritingItem post={post} />)}</div>
    </section>

    <section class="section-block" aria-labelledby="working-principles">
      <div class="section-heading"><span class="eyebrow">WORKING PRINCIPLES</span><h2 id="working-principles">工程表达的三条底线</h2></div>
      <div class="principles">
        <article class="principle"><span class="principle-no">01 / REAL</span><h3>从真实场景出发</h3><p>功能必须回应实际问题，而不是为了展示技术而制造需求。</p></article>
        <article class="principle"><span class="principle-no">02 / VISIBLE</span><h3>让结构变得可见</h3><p>无论是磁盘目录还是自动化流程，清晰的结构都是理解和操作的起点。</p></article>
        <article class="principle"><span class="principle-no">03 / VERIFIED</span><h3>区分结果与证据</h3><p>写清测试环境、已知限制与归因，不把一次运行包装成普遍结论。</p></article>
      </div>
    </section>
  </div>
</BaseLayout>
