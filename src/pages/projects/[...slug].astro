---
import { getFeedItems, getPublishedProjects } from '../../content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StorageScopeShowcase from '../../components/StorageScopeShowcase.astro';

export async function getStaticPaths() {
  const [projects, feed] = await Promise.all([getPublishedProjects(), getFeedItems()]);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, relatedWriting: feed.filter((item) => item.project === project.id) },
  }));
}
const { project, relatedWriting } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const interfaceArticle = relatedWriting.find((item) => item.id === 'storagescope-3d-tree' && item.type === '长文');
---
<BaseLayout title={data.title} description={data.description} image={data.presentation.cover?.src} imageAlt={data.presentation.cover?.alt}>
  <div class="shell">
    <header class="project-hero">
      <div class="project-hero-top"><a class="back-link" href="/projects/">← 返回项目架</a><span class="status-label">{data.status}</span></div>
      <span class="eyebrow">开发复盘 / {data.role}</span>
      <h1>{data.title}</h1>
      <p class="project-lede">{data.tagline}</p>
      <p class="project-summary">{data.description}</p>
      <div class="button-row">
        <a class="button" href={data.repo} target="_blank" rel="noreferrer">查看源代码 <span>↗</span></a>
        {data.release && <a class="button secondary" href={data.release} target="_blank" rel="noreferrer">获取发布版 <span>↗</span></a>}
      </div>
      <div class="project-meta-grid">
        <div class="meta-cell"><span>ROLE / 职责</span><p>{data.role}</p></div>
        <div class="meta-cell"><span>STACK / 实现</span><p>{data.stack.join(' · ')}</p></div>
        <div class="meta-cell"><span>STATUS / 版本</span><p>{data.status}</p></div>
      </div>
    </header>

    {project.id === 'storagescope' && <StorageScopeShowcase articleUrl={interfaceArticle?.url} />}
    {data.contribution && <p class="contribution-note"><strong>贡献说明：</strong>{data.contribution}</p>}

    <div class="project-body">
      <aside class="project-body-aside"><span class="eyebrow">从问题到证据</span><p>下面依次记录缘起、能力、实现、难点、踩坑、验证、不足、版本与个人贡献。</p></aside>
      <div class="prose"><Content /></div>
    </div>

    {data.metrics.length > 0 && <section class="project-evidence" aria-labelledby="evidence-title">
      <span class="eyebrow">VERIFICATION / 已记录验证</span>
      <h2 id="evidence-title">数字放在上下文里。</h2>
      <div class="evidence-grid">{data.metrics.map((metric) => <div class="evidence-item"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
      {data.evidenceNote && <p class="muted">{data.evidenceNote}</p>}
    </section>}
    {relatedWriting.length > 0 && <section class="project-related" aria-labelledby="related-writing-title">
      <div class="section-heading">
        <div><span class="eyebrow">FIELD NOTES / 延伸阅读</span><h2 id="related-writing-title">这个项目的开发记录</h2></div>
      </div>
      <ul>
        {relatedWriting.slice(0, 4).map((item) => <li>
          <span class="muted">{item.type}</span>
          <a class="text-link" href={item.url}>{item.title}</a>
        </li>)}
      </ul>
    </section>}
    <div class="project-footer-links"><a class="text-link" href="/projects/">返回项目架 →</a><a class="text-link" href={data.repo} target="_blank" rel="noreferrer">在 GitHub 查看当前实现 ↗</a></div>
  </div>
</BaseLayout>
