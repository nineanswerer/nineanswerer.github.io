---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---
<BaseLayout title={data.title} description={data.description} image={data.featured ? '/images/storagescope-tree.webp' : undefined}>
  <div class="shell">
    <header class="project-hero">
      <div class="project-hero-top"><a class="back-link" href="/projects/">← 返回工具架</a><span class="status-label">{data.status}</span></div>
      <span class="eyebrow">开发复盘 / {data.role}</span>
      <h1>{data.title}</h1>
      <p class="project-lede">{data.tagline}</p>
      <p class="project-summary">{data.description}</p>
      <div class="button-row">
        <a class="button" href={data.repo} target="_blank" rel="noreferrer">查看源代码 <span>↗</span></a>
        {data.release && <a class="button secondary" href={data.release} target="_blank" rel="noreferrer">获取 v0.1.0 发布版 <span>↗</span></a>}
      </div>
      <div class="project-meta-grid">
        <div class="meta-cell"><span>ROLE / 职责</span><p>{data.role}</p></div>
        <div class="meta-cell"><span>STACK / 实现</span><p>{data.stack.join(' · ')}</p></div>
        <div class="meta-cell"><span>STATUS / 版本</span><p>{data.status}</p></div>
      </div>
    </header>

    {data.featured && <figure class="project-cover"><img src="/images/storagescope-tree.webp" alt="StorageScope 三维目录树，节点通过连线表示目录层级" width="1384" height="841" /><figcaption><span>STORAGESCOPE / 3D DIRECTORY TREE</span><span>真实应用截图，已隐去本机路径</span></figcaption></figure>}
    {data.contribution && <p class="contribution-note"><strong>贡献说明：</strong>{data.contribution}</p>}

    <div class="project-body">
      <aside class="project-body-aside"><span class="eyebrow">从问题到证据</span><p>下面依次记录缘起、能力、实现、难点、踩坑、验证、不足、版本与个人贡献。</p></aside>
      <div class="prose"><Content /></div>
    </div>

    {data.metrics.length > 0 && <section class="project-evidence" aria-labelledby="evidence-title">
      <span class="eyebrow">VERIFICATION / 同一次真实验证</span>
      <h2 id="evidence-title">数字放在上下文里。</h2>
      <div class="evidence-grid">{data.metrics.map((metric) => <div class="evidence-item"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
      <p class="muted">约 24 秒只是包含固定等待的单次自动化流程记录，不是性能基准。验证范围与限制见上文。</p>
    </section>}
    <div class="project-footer-links"><a class="text-link" href="/writing/storagescope-3d-tree/" hidden={!data.featured}>读 3D 目录树技术复盘 →</a><a class="text-link" href={data.repo} target="_blank" rel="noreferrer">在 GitHub 查看当前实现 ↗</a></div>
  </div>
</BaseLayout>
