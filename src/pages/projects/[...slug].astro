---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---
<BaseLayout title={data.title} description={data.description} image={data.featured ? '/images/storagescope-tree.webp' : undefined}>
  <div class="shell">
    <header class="project-hero">
      <div class="project-hero-top"><a class="back-link" href="/projects/">← 返回项目索引</a><span class="status-label">{data.status}</span></div>
      <span class="eyebrow">PROJECT CASE / {data.role}</span>
      <h1>{data.title}</h1>
      <p class="project-lede">{data.tagline}</p>
      <p class="project-summary">{data.description}</p>
      <div class="button-row">
        <a class="button" href={data.repo} target="_blank" rel="noreferrer">查看源代码 <span>↗</span></a>
        {data.release && <a class="button secondary" href={data.release} target="_blank" rel="noreferrer">获取发布版 <span>↗</span></a>}
      </div>
      <div class="project-meta-grid">
        <div class="meta-cell"><span>ROLE / 职责</span><p>{data.role}</p></div>
        <div class="meta-cell"><span>STACK / 技术栈</span><p>{data.stack.join(' · ')}</p></div>
        <div class="meta-cell"><span>STATUS / 状态</span><p>{data.status}</p></div>
      </div>
    </header>

    {data.metrics.length > 0 && <section class="project-metrics" aria-label="项目验证数据">{data.metrics.map((metric) => <div class="project-metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</section>}

    {data.featured && <figure class="project-cover"><img src="/images/storagescope-tree.webp" alt="StorageScope 三维目录树，节点通过连线表示目录层级" width="1384" height="841" /><figcaption><span>STORAGESCOPE / 3D DIRECTORY TREE</span><span>真实应用截图，已隐去本机路径</span></figcaption></figure>}
    {data.contribution && <p class="contribution-note"><strong>贡献说明：</strong>{data.contribution}</p>}

    <div class="project-body">
      <aside class="project-body-aside"><span class="eyebrow">CASE NOTES</span><p>以下记录基于当前仓库与已完成的验证。未覆盖的场景不会被写成既成能力。</p></aside>
      <div class="prose"><Content /></div>
    </div>
  </div>
</BaseLayout>
