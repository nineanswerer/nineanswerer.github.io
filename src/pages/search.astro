---
import { getPublishedProjects } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeedItems } from '../content';
const projects = await getPublishedProjects();
const feed = await getFeedItems();
const items = [
  ...projects.map((project) => ({ type: '项目', title: project.data.title, description: project.data.description, url: `/projects/${project.id}/`, keywords: [...project.data.stack, project.data.tagline, project.data.role].join(' ') })),
  ...feed.map((item) => ({ type: item.type, title: item.title, description: item.description, url: item.url, keywords: item.tags.join(' ') })),
];
---
<BaseLayout title="搜索" description="在九术的工作台中搜索项目、长文与开发碎片。查询只在浏览器本地完成。">
  <div class="shell">
    <header class="page-header index-header">
      <div><span class="eyebrow">LOCAL INDEX / 本地搜索</span><h1>找一张纸条。</h1></div>
      <div class="page-intro"><p>搜索标题、简介、技术栈与标签。索引随网站一起静态生成，查询只在你的浏览器中完成。</p></div>
    </header>
    <section class="search-panel" aria-label="站内搜索">
      <div class="search-box"><label for="search-input">输入关键词</label><input id="search-input" type="search" placeholder="例如：Rust、目录树、时区" autocomplete="off" /></div>
      <p class="search-count" id="search-count" aria-live="polite">{items.length} 条结果</p>
      <div id="search-results"></div>
      <noscript><p class="noscript-note">本地搜索需要启用 JavaScript。不启用脚本也可以直接浏览<a class="accent" href="/projects/">项目</a>或<a class="accent" href="/writing/">全部博客内容</a>。</p></noscript>
    </section>
  </div>
  <script id="search-data" type="application/json" set:html={JSON.stringify(items).replaceAll('<', '\u003c')}></script>
</BaseLayout>
<script>
  type SearchItem = { type: string; title: string; description: string; url: string; keywords: string };
  const dataElement = document.querySelector<HTMLScriptElement>('#search-data');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = document.querySelector<HTMLDivElement>('#search-results');
  const count = document.querySelector<HTMLParagraphElement>('#search-count');
  if (dataElement && input && results && count) {
    const items: SearchItem[] = JSON.parse(dataElement.textContent ?? '[]');
    const render = (query: string) => {
      const keyword = query.trim().toLocaleLowerCase();
      const filtered = keyword ? items.filter((item) => `${item.title} ${item.description} ${item.keywords}`.toLocaleLowerCase().includes(keyword)) : items;
      count.textContent = `${filtered.length} 条结果${keyword ? ` · “${query.trim()}”` : ''}`;
      results.replaceChildren();
      if (!filtered.length) {
        const empty = document.createElement('p');
        empty.className = 'search-empty';
        empty.textContent = '桌上没有找到这张纸条。试试更短的关键词，或去博客翻完整索引。';
        results.append(empty);
        return;
      }
      filtered.forEach((item) => {
        const link = document.createElement('a');
        link.className = 'search-result';
        link.href = item.url;
        link.dataset.searchResult = '';
        const type = document.createElement('span');
        type.className = 'result-type';
        type.textContent = item.type;
        const title = document.createElement('h2');
        title.textContent = item.title;
        const description = document.createElement('p');
        description.textContent = item.description;
        link.append(type, title, description);
        results.append(link);
      });
    };
    const initial = new URLSearchParams(location.search).get('q') ?? '';
    input.value = initial;
    render(initial);
    input.addEventListener('input', () => {
      render(input.value);
      const url = new URL(location.href);
      input.value.trim() ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    });
  }
</script>
