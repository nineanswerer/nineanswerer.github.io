---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingItem from '../../components/WritingItem.astro';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="实践笔记" description="关于桌面可视化、静态网站、GitHub Pages 与数据处理的实践笔记。">
  <div class="shell">
    <header class="page-header">
      <div><span class="eyebrow">FIELD NOTES</span><h1>实践笔记</h1></div>
      <div class="page-intro"><p>不写面面俱到的教程，只整理亲手验证过的流程、值得复用的方法，以及容易误判的地方。</p><a class="text-link" href="/rss.xml">订阅 RSS ↗</a></div>
    </header>
    <section class="page-content" aria-label="全部文章">
      <div class="page-meta"><span>{posts.length} 篇公开笔记</span><span>按发布日期排序</span></div>
      <div class="writing-list">{posts.map((post) => <WritingItem post={post} />)}</div>
    </section>
  </div>
</BaseLayout>
