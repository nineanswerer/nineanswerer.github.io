---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeedItems } from '../../content';
import { formatDate } from '../../utils';
const items = await getFeedItems();
---
<BaseLayout title="博客" description="九术的技术博客：完整开发复盘，以及从真实制作过程中留下的短笔记。">
  <div class="shell">
    <header class="page-header index-header">
      <div><span class="eyebrow">NOTES & ESSAYS / 博客</span><h1>写过的东西，<br />和还热着的想法。</h1></div>
      <div class="page-intro"><p>长文把过程讲完整，碎片留住一个具体决定。内容来自实际制作。</p><a class="text-link" href="/rss.xml">订阅长文与碎片 ↗</a></div>
    </header>
    <section class="page-content" aria-label="全部博客内容">
      <div class="page-meta"><span>{items.filter((item) => item.type === '长文').length} 篇长文 / {items.filter((item) => item.type === '碎片').length} 篇碎片</span><span>按日期与修订排序</span></div>
      <div class="blog-filters" data-blog-filters hidden aria-label="筛选写作类型">
        <button type="button" data-blog-filter="全部" aria-pressed="true">全部</button>
        <button type="button" data-blog-filter="长文" aria-pressed="false">长文</button>
        <button type="button" data-blog-filter="碎片" aria-pressed="false">碎片</button>
        <span class="filter-note" data-filter-count aria-live="polite">{items.length} 条记录</span>
      </div>
      <ol class="blog-index-list" data-blog-list>
        {items.map((item) => <li class="blog-entry" data-feed-kind={item.type}>
          <a href={item.url}>
            <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
            <span class:list={['update-type', { 'is-note': item.type === '碎片' }]}>{item.type}</span>
            <div><h2>{item.title}</h2><p>{item.description}</p><ul class="inline-tags" aria-label="标签">{item.tags.map((tag) => <li>{tag}</li>)}</ul></div>
            <span class="writing-arrow" aria-hidden="true">↗</span>
          </a>
        </li>)}
      </ol>
      <p class="filter-empty" data-filter-empty hidden>这一栏暂时没有内容，去看看其他记录吧。</p>
    </section>
  </div>
</BaseLayout>
<script>
  const filterBar = document.querySelector<HTMLElement>('[data-blog-filters]');
  if (filterBar) {
    filterBar.hidden = false;
    const buttons = filterBar.querySelectorAll<HTMLButtonElement>('[data-blog-filter]');
    const entries = document.querySelectorAll<HTMLElement>('[data-feed-kind]');
    const count = filterBar.querySelector<HTMLElement>('[data-filter-count]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const selected = button.dataset.blogFilter;
      let visible = 0;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      entries.forEach((entry) => {
        const show = selected === '全部' || entry.dataset.feedKind === selected;
        entry.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = `${visible} 条记录`;
      if (empty) empty.hidden = visible !== 0;
    }));
  }
</script>
